generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ============================================================
// ENUMS
// ============================================================

enum ProductType {
  SIMPLE
  VARIABLE
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
  RETURNED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum UserRole {
  USER
  B2B_USER
  SUPERADMIN
  COMPANY_ADMIN
  INVENTORY_MANAGER
  WAREHOUSE_MANAGER
  EMPLOYEE
}

enum OrderAddressType {
  SHIPPING
  BILLING
}

enum BulkBusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BulkProductType {
  SIMPLE
  VARIABLE
}

enum BulkOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum BulkPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BulkShippingStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
}


// ============================================================
// USER
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String

  firstName String?
  lastName  String?
  imageUrl  String?

  isActive Boolean @default(true)
  role     UserRole @default(USER)
  emailVerifiedAt DateTime?

  countryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country? @relation(fields: [countryId], references: [id])

  bulkBusinessId String?
  bulkBusiness   BulkBusiness? @relation(fields: [bulkBusinessId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  carts  Cart[]
  orders Order[]
  addresses UserAddress[]
  reviews Review[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  inventoryTransactions  InventoryTransaction[]
  inventoryTransfers    InventoryTransfer[]

  @@index([countryId])
  @@index([bulkBusinessId])
  @@index([organizationId])
  @@index([isActive])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


// ============================================================
// COUNTRY
// ============================================================

model Country {
  id   String @id @default(cuid())
  code String @unique
  name String

  currencyId String

  currency Currency @relation(fields: [currencyId], references: [id])

  users User[]

  productCountries        ProductCountry[]
  variantCountries        ProductVariantCountry[]
  bannerCountries         BannerCountry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ============================================================
// CURRENCY
// ============================================================

model Currency {
  id     String @id @default(cuid())
  code   String @unique
  name   String
  symbol String

  countries Country[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ============================================================
// CATEGORY
// ============================================================

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique

  imageUrl String?
  sortOrder Int      @default(0)

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
}


// ============================================================
// BRAND
// ============================================================

model Brand {
  id   String @id @default(cuid())
  name String
  slug String @unique

  imageUrl String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
}


// ============================================================
// PRODUCT
// ============================================================

model Product {
  id String @id @default(cuid())

  name        String
  slug        String @unique
  description String?

  type ProductType @default(SIMPLE)

  sku String? @unique

  /**
   * Used only as the default/base price.
   *
   * Actual selling price should come from:
   *
   * SIMPLE   -> ProductCountry
   * VARIABLE -> ProductVariantCountry
   */
  basePrice Decimal? @db.Decimal(12, 2)

  /**
   * Used for SIMPLE products.
   *
   * For VARIABLE products, stock should normally
   * be calculated from variants.
   */
  stock Int @default(0)

  isActive Boolean @default(true)
  isNew Boolean @default(false)
  isFeatured Boolean @default(false)
  isTrending Boolean @default(false)
  isBestSeller Boolean @default(false)
  deletedAt DateTime?

  deliveryInfo String?
  returnPolicy String?
  warrantyInfo String?
  keyHighlights Json?

  weight        Decimal? @db.Decimal(10, 2)
  weightUnit    String?  @default("lb")
  length        Decimal? @db.Decimal(10, 2)
  width         Decimal? @db.Decimal(10, 2)
  height        Decimal? @db.Decimal(10, 2)
  dimensionUnit String?  @default("in")

  brandId    String?
  categoryId String?

  brand Brand? @relation(fields: [brandId], references: [id])

  category Category? @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]

  countries ProductCountry[]

  images ProductImage[]

  cartItems CartItem[]

  orderItems OrderItem[]

  reviews Review[]
  inventories Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([categoryId])
  @@index([type])
  @@index([isActive])
  @@index([name])
}


// ============================================================
// REVIEW
// ============================================================

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String?
  comment   String?
  images    String[] @default([])

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([rating])
}


// ============================================================
// PRODUCT COUNTRY
// ============================================================
//
// Country-level configuration for the PRODUCT.
//
// Example:
//
// Product 1
//
// USA     -> available -> $10
// Canada  -> available -> $15
//
// This is mainly used for SIMPLE products.
//
// For VARIABLE products, variant country configuration
// should be used for the final price/availability.
// ============================================================

model ProductCountry {
  id String @id @default(cuid())

  productId String
  countryId String

  isAvailable Boolean @default(true)

  oldPrice Decimal? @db.Decimal(12, 2)

  /**
   * Country-specific product price.
   *
   * Example:
   *
   * USA    = 10
   * Canada = 15
   */
  price Decimal? @db.Decimal(12, 2)
  stock Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([productId, countryId])
  @@index([countryId])
  @@index([productId])
  @@index([isAvailable])
}


// ============================================================
// PRODUCT VARIANT
// ============================================================
//
// Examples:
//
// Product: T-Shirt
//
// Variant 1
// XL / Red
//
// Variant 2
// XL / Blue
//
// Variant 3
// XXL / Red
//
// attributes stores dynamic options.
//
// Example:
// {
//   "size": "XL",
//   "color": "Red"
// }
// ============================================================

model ProductVariant {
  id String @id @default(cuid())

  productId String

  sku String @unique

  name String?

  /**
   * Example:
   *
   * {
   *   "size": "XL",
   *   "color": "Red"
   * }
   */
  attributes Json?

  stock Int @default(0)

  weight        Decimal? @db.Decimal(10, 2)
  weightUnit    String?  @default("lb")
  length        Decimal? @db.Decimal(10, 2)
  width         Decimal? @db.Decimal(10, 2)
  height        Decimal? @db.Decimal(10, 2)
  dimensionUnit String?  @default("in")

  isActive Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  countries ProductVariantCountry[]

  cartItems CartItem[]

  orderItems OrderItem[]
  inventories Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
}


// ============================================================
// PRODUCT VARIANT COUNTRY
// ============================================================
//
// THIS IS THE IMPORTANT TABLE.
//
// Allows each variant to have:
//
// - Different price per country
// - Different availability per country
//
// Example:
//
// XL
//
// USA
// price       = $15
// available   = true
//
// Canada
// price       = null
// available   = false
// ============================================================

model ProductVariantCountry {
  id String @id @default(cuid())

  variantId String
  countryId String

  isAvailable Boolean @default(true)

  price Decimal? @db.Decimal(12, 2)
  oldPrice Decimal? @db.Decimal(12, 2)
  stock Int @default(0)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([variantId, countryId])
  @@index([variantId])
  @@index([countryId])
  @@index([isAvailable])
}


// ============================================================
// PRODUCT IMAGE
// ============================================================

model ProductImage {
  id String @id @default(cuid())

  productId String

  fileId String?

  url String

  sortOrder Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  file File? @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([fileId])
}


// ============================================================
// FILE
// ============================================================

model File {
  id String @id @default(cuid())

  originalName String

  storageKey String

  mimeType String

  size Int

  url String?

  createdAt DateTime @default(now())

  productImages ProductImage[]
}


// ============================================================
// CART
// ============================================================

model Cart {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@unique([userId])
}


// ============================================================
// CART ITEM
// ============================================================

model CartItem {
  id String @id @default(cuid())

  cartId String

  productId String

  variantId String?

  quantity Int @default(1)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  variant ProductVariant? @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Prevent duplicate cart rows for the same
   * product + variant.
   *
   * For a simple product:
   *
   * cartId + productId + null
   *
   * For a variant:
   *
   * cartId + productId + variantId
   */
  @@unique([cartId, productId, variantId])

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}


// ============================================================
// ORDER
// ============================================================

model Order {
  id String @id @default(cuid())

  userId String

  status OrderStatus @default(PENDING)

  /**
   * Currency used when order was created.
   *
   * Example:
   *
   * USD
   * CAD
   * INR
   */
  currencyCode String

  subtotal Decimal @db.Decimal(12, 2)

  discount Decimal @default(0) @db.Decimal(12, 2)

  shippingCharges Decimal @default(0) @db.Decimal(12, 2)

  tax Decimal @default(0) @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  user User @relation(fields: [userId], references: [id])

  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  warehouseId            String?
  inventoryReserved      Boolean       @default(false)
  inventoryDeducted      Boolean       @default(false)
  stripePaymentIntentId  String?
  stripeTaxCalculationId String?
  metadata               Json?

  // Shippo shipping fields
  shippingMethod         String?
  shippingCarrier        String?
  shippingRateId         String?

  items         OrderItem[]
  addresses     OrderAddress[]
  invoices      Invoice[]
  shipments     Shipment[]
  rateSnapshots ShippingRateSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([status])
  @@index([stripePaymentIntentId])
  @@index([createdAt])
}

model OrderAddress {
  id String @id @default(cuid())

  orderId String
  type OrderAddressType

  fullName String
  phone String
  addressLine1 String
  addressLine2 String?
  city String
  state String?
  postalCode String
  countryCode String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, type])
  @@index([orderId])
}

model UserAddress {
  id           String   @id @default(cuid())
  userId       String
  name         String?
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  countryCode  String   @default("US")
  isDefault    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isDefault])
}


// ============================================================
// ORDER ITEM
// ============================================================
//
// Important:
//
// We store productName, sku and unitPrice as snapshots.
//
// If product price changes later,
// old orders remain unchanged.
// ============================================================

model OrderItem {
  id String @id @default(cuid())

  orderId String

  productId String

  variantId String?

  productName String

  sku String?

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  variant ProductVariant? @relation(fields: [variantId], references: [id])

  shipmentItems ShipmentItem[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}


// ============================================================
// COUPON
// ============================================================

model Coupon {
  id String @id @default(cuid())

  code String @unique

  type CouponType

  /**
   * PERCENTAGE:
   *
   * 10 = 10%
   *
   * FIXED:
   *
   * 10 = $10
   */
  value Decimal @db.Decimal(12, 2)

  minOrder Decimal? @db.Decimal(12, 2)

  maxDiscount Decimal? @db.Decimal(12, 2)

  usageLimit Int?

  usedCount Int @default(0)

  startsAt DateTime?

  expiresAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([startsAt])
  @@index([expiresAt])
}


// ============================================================
// BANNER
// ============================================================

model Banner {
  id String @id @default(cuid())

  title String

  imageUrl String

  linkUrl String?

  sortOrder Int @default(0)

  startsAt DateTime?

  expiresAt DateTime?

  isActive Boolean @default(true)

  countries BannerCountry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}


// ============================================================
// BANNER COUNTRY
// ============================================================
//
// Example:
//
// Banner 1
//
// USA     -> visible
// Canada  -> visible
// India   -> not configured
// ============================================================

model BannerCountry {
  id String @id @default(cuid())

  bannerId String

  countryId String

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([bannerId, countryId])
  @@index([countryId])
}

// ============================================================
// BULK / B2B DOMAIN (intentionally independent of public commerce tables)
// ============================================================

model BulkBusiness {
  id                    String              @id @default(cuid())
  businessName          String
  businessEmail         String              @unique
  businessPhone         String
  taxRegistrationNumber String?
  registrationNumber    String?
  countryCode           String
  address               String
  contactPersonName     String
  status                BulkBusinessStatus  @default(PENDING)
  isLocked              Boolean             @default(false)
  approvedBy            String?
  approvedAt            DateTime?
  rejectionReason       String?
  documents             Json?               @default("[]")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  users     User[]
  addresses BulkAddress[]
  cart      BulkCart?
  orders    BulkOrder[]

  @@index([status])
  @@index([businessName])
  @@index([countryCode])
  @@index([createdAt])
}

model BulkProduct {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  sku         String?         @unique
  description String?
  category    String?
  brand       String?
  type        BulkProductType @default(SIMPLE)
  isActive    Boolean         @default(true)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  images        BulkProductImage[]
  countryPrices BulkProductCountryPrice[]
  variants      BulkProductVariant[]
  cartItems     BulkCartItem[]
  orderItems    BulkOrderItem[]

  @@index([name])
  @@index([sku])
  @@index([isActive])
  @@index([createdAt])
}

model BulkProductImage {
  id            String      @id @default(cuid())
  productId     String
  mediaAssetId  String
  isPrimary     Boolean     @default(false)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  product       BulkProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([mediaAssetId])
}

model BulkProductVariant {
  id          String       @id @default(cuid())
  productId   String
  name        String?
  sku         String       @unique
  weight      Decimal?     @db.Decimal(10, 3)
  weightUnit  String?      @default("kg")
  sortOrder   Int          @default(0)
  attributes  Json?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  product       BulkProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  countryPrices BulkVariantCountryPrice[]
  cartItems     BulkCartItem[]
  orderItems    BulkOrderItem[]

  @@index([productId])
  @@index([isActive])
}

model BulkProductCountryPrice {
  id           String   @id @default(cuid())
  productId    String
  countryCode  String
  currencyCode String
  unitPrice    Decimal? @db.Decimal(12, 2)
  moq          Int      @default(1)
  stock        Int      @default(0)
  isAvailable  Boolean  @default(true)
  product      BulkProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  tiers        BulkPricingTier[]

  @@unique([productId, countryCode])
  @@index([countryCode])
  @@index([isAvailable])
}

model BulkVariantCountryPrice {
  id           String              @id @default(cuid())
  variantId    String
  countryCode  String
  currencyCode String
  unitPrice    Decimal             @default(0) @db.Decimal(12, 2)
  moq          Int                 @default(1)
  stock        Int                 @default(0)
  isAvailable  Boolean             @default(true)
  variant      BulkProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tiers        BulkPricingTier[]

  @@unique([variantId, countryCode])
  @@index([countryCode])
  @@index([isAvailable])
}

model BulkPricingTier {
  id                 String                    @id @default(cuid())
  productPriceId     String?
  variantPriceId     String?
  minQuantity        Int
  maxQuantity        Int?
  price              Decimal                   @db.Decimal(12, 2)
  productPrice       BulkProductCountryPrice?  @relation(fields: [productPriceId], references: [id], onDelete: Cascade)
  variantPrice       BulkVariantCountryPrice?  @relation(fields: [variantPriceId], references: [id], onDelete: Cascade)

  @@index([productPriceId, minQuantity])
  @@index([variantPriceId, minQuantity])
}

model BulkCart {
  id         String          @id @default(cuid())
  businessId String          @unique
  business   BulkBusiness     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      BulkCartItem[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model BulkCartItem {
  id        String              @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  cart      BulkCart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   BulkProduct          @relation(fields: [productId], references: [id])
  variant   BulkProductVariant?  @relation(fields: [variantId], references: [id])
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model BulkAddress {
  id           String       @id @default(cuid())
  businessId   String
  label        String
  contactName  String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  countryCode  String
  isDefault    Boolean      @default(false)
  business     BulkBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([businessId])
  @@index([isDefault])
}

model BulkOrder {
  id              String             @id @default(cuid())
  orderNumber     String             @unique
  businessId      String
  countryCode     String
  currencyCode    String
  status          BulkOrderStatus    @default(PENDING)
  paymentStatus   BulkPaymentStatus  @default(PENDING)
  shippingStatus  BulkShippingStatus @default(PENDING)
  subtotal        Decimal            @db.Decimal(12, 2)
  discount        Decimal            @default(0) @db.Decimal(12, 2)
  shippingCharges Decimal            @default(0) @db.Decimal(12, 2)
  tax             Decimal            @default(0) @db.Decimal(12, 2)
  total           Decimal            @db.Decimal(12, 2)
  shippingAddress Json
  business        BulkBusiness       @relation(fields: [businessId], references: [id])
  items           BulkOrderItem[]
  invoices        Invoice[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([businessId])
  @@index([status])
  @@index([countryCode])
  @@index([createdAt])
}

model BulkOrderItem {
  id           String              @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  productName  String
  description  String?
  sku          String?
  weight       Decimal?            @db.Decimal(10, 3)
  weightUnit   String?             @default("kg")
  imageUrl     String?
  quantity     Int
  unitPrice    Decimal             @db.Decimal(12, 2)
  appliedTier  Json?
  currencyCode String
  countryCode  String
  total        Decimal             @db.Decimal(12, 2)
  order        BulkOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      BulkProduct         @relation(fields: [productId], references: [id])
  variant      BulkProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// ============================================================
// INVOICE (Production Financial Audit & PDF Storage)
// ============================================================

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  orderId       String?       @unique
  bulkOrderId   String?       @unique
  status        InvoiceStatus @default(ISSUED)
  fileUrl       String?
  storageKey    String?
  currencyCode  String        @default("USD")
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  shippingAmount Decimal      @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  issuedAt      DateTime      @default(now())
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order         Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bulkOrder     BulkOrder?    @relation(fields: [bulkOrderId], references: [id], onDelete: Cascade)

  @@index([invoiceNumber])
  @@index([orderId])
  @@index([bulkOrderId])
  @@index([status])
  @@index([issuedAt])
}

// ============================================================
// STORE SETTINGS & DETAILS
// ============================================================

model StoreSetting {
  id                  String   @id @default(cuid())
  
  // General Store Details
  storeName           String   @default("Vanom")
  storeTagline        String?
  description         String?
  logoUrl             String?
  darkLogoUrl         String?
  faviconUrl          String?

  // Contact Information
  email               String?
  supportEmail        String?
  phone               String?
  whatsapp            String?

  // Business Address
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  postalCode          String?
  country             String?

  // Tax & Legal
  taxId               String?  // GSTIN / VAT / EIN
  businessRegistration String? // Company / Business Reg No
  legalName           String?

  // Social Links
  instagramUrl        String?
  facebookUrl         String?
  twitterUrl          String?
  linkedinUrl         String?
  youtubeUrl          String?

  // Operational & Storefront Settings
  isMaintenanceMode   Boolean  @default(false)
  maintenanceMessage  String?
  announcementBarText String?
  isAnnouncementActive Boolean @default(false)
  
  // Order & Inventory Defaults
  defaultCurrency     String   @default("USD")
  lowStockThreshold   Int      @default(5)
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  standardShippingFee   Decimal? @db.Decimal(12, 2)
  taxRatePercentage     Decimal? @db.Decimal(5, 2)

  // Invoice & Policy Notes
  invoicePrefix       String?  @default("INV-")
  invoiceFooterNote   String?

  // Flexible Metadata for future extensible settings
  metadata            Json?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ============================================================
// CONTACT MESSAGES (Storefront Inquiries & Support)
// ============================================================

enum ContactStatus {
  PENDING
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String        @default("General Inquiry")
  message   String
  status    ContactStatus @default(PENDING)
  ipAddress String?

  adminNotes String?
  repliedAt  DateTime?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

// ============================================================
// INVENTORY & WAREHOUSE MANAGEMENT SYSTEM
// ============================================================

enum InventoryTransactionType {
  PURCHASE
  SALE
  RESERVATION
  RELEASE
  RETURN
  RESTOCK
  ADJUSTMENT
  DAMAGE
  LOSS
  TRANSFER_IN
  TRANSFER_OUT
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  code      String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  warehouses            Warehouse[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]
  inventoryTransfers    InventoryTransfer[]
  orders                Order[]

  @@index([isActive])
}

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  address        String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  phone          String?
  email          String?
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventories          Inventory[]
  sourceTransfers      InventoryTransfer[] @relation("SourceWarehouse")
  destinationTransfers InventoryTransfer[] @relation("DestinationWarehouse")
  shipments            Shipment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
}

model Inventory {
  id               String   @id @default(cuid())
  organizationId   String
  warehouseId      String
  productId        String?
  variantId        String?
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  reorderLevel     Int      @default(10)
  reorderQuantity  Int      @default(20)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  transactions     InventoryTransaction[]
  transferItems    InventoryTransferItem[]

  @@unique([warehouseId, variantId])
  @@unique([warehouseId, productId])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, productId])
  @@index([organizationId, variantId])
}

model InventoryTransaction {
  id                       String                   @id @default(cuid())
  organizationId           String
  inventoryId              String
  type                     InventoryTransactionType
  quantity                 Int
  previousQuantity         Int
  newQuantity              Int
  previousReservedQuantity Int                      @default(0)
  newReservedQuantity      Int                      @default(0)
  referenceId              String?
  referenceType            String?                  // ORDER, PURCHASE_ORDER, TRANSFER, RETURN, MANUAL, STRIPE_PAYMENT
  reason                   String?
  notes                    String?
  createdById              String?
  createdAt                DateTime                 @default(now())

  organization             Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventory                Inventory                @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  createdBy                User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([inventoryId])
  @@index([type])
  @@index([referenceId, referenceType])
  @@index([organizationId, createdAt])
  @@index([inventoryId, createdAt])
}

model InventoryTransfer {
  id                     String         @id @default(cuid())
  organizationId         String
  transferNumber         String         @unique
  sourceWarehouseId      String
  destinationWarehouseId String
  status                 TransferStatus @default(PENDING)
  notes                  String?
  createdById            String?
  createdAt              DateTime       @default(now())
  completedAt            DateTime?

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceWarehouse        Warehouse               @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse   Warehouse               @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  createdBy              User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items                  InventoryTransferItem[]

  @@index([organizationId])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
}

model InventoryTransferItem {
  id          String            @id @default(cuid())
  transferId  String
  inventoryId String
  quantity    Int

  transfer    InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  inventory   Inventory         @relation(fields: [inventoryId], references: [id])

  @@index([transferId])
  @@index([inventoryId])
}


// ============================================================
// SHIPPING & SHIPMENT (Shippo Multi-Warehouse Integration)
// ============================================================

model Shipment {
  id                  String         @id @default(cuid())
  organizationId      String
  orderId             String
  warehouseId         String?

  shippoShipmentId    String?
  shippoTransactionId String?
  shippoRateId        String?

  carrier             String?
  service             String?
  serviceLevel        String?

  trackingNumber      String?
  trackingUrl         String?
  labelUrl            String?
  labelStorageKey     String?

  status              ShipmentStatus @default(PENDING)

  shippingCost        Decimal        @default(0) @db.Decimal(12, 2)
  currency            String         @default("USD")

  estimatedDeliveryDate DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?

  metadata            Json?

  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse           Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items               ShipmentItem[]

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([organizationId])
  @@index([orderId])
  @@index([warehouseId])
  @@index([status])
  @@index([shippoShipmentId])
  @@index([shippoTransactionId])
  @@index([trackingNumber])
  @@index([orderId, status])
}

model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int       @default(1)

  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@index([shipmentId])
  @@index([orderItemId])
}

model ShippingRateSnapshot {
  id            String   @id @default(cuid())
  orderId       String
  shippoRateId  String
  carrier       String
  service       String
  serviceLevel  String?
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  estimatedDays Int?
  isDefault     Boolean  @default(false)
  rawData       Json?

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([shippoRateId])
}

model ShippoWebhookEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  eventType      String
  carrier        String?
  trackingNumber String?
  payload        Json
  processedAt    DateTime @default(now())

  @@index([eventId])
  @@index([eventType])
  @@index([trackingNumber])
}



