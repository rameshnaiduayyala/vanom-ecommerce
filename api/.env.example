PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"
JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="7d"
PASSWORD_RESET_EXPIRES_MINUTES=30
EMAIL_VERIFICATION_EXPIRES_MINUTES=60
APP_URL=http://localhost:3000
# Email Providers (resend, ses, smtp, console)
# In development (NODE_ENV=development), emails automatically route to local Papercut SMTP
EMAIL_PROVIDER=console
EMAIL_FROM="Vanom <noreply@example.com>"
RESEND_API_KEY=
AWS_REGION=us-east-1
SMS_PROVIDER=console

# Local Papercut SMTP (defaults to 127.0.0.1:25)
PAPERCUT_HOST=127.0.0.1
PAPERCUT_PORT=25

# SMTP / Nodemailer (used when EMAIL_PROVIDER=smtp in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RATE_LIMIT_WINDOW_MS=60000
UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads
ASSET_DIR=assets
ASSET_PUBLIC_URL=http://localhost:3000/assets
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1920
IMAGE_WEBP_QUALITY=82
# S3 / S3-compatible storage (used when UPLOAD_PROVIDER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
NODE_ENV="development"

# Stripe (Payment & Tax)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Shippo (Shipping, Rates, Labels & Tracking)
# Development: shippo_test_... | Production: shippo_live_...
SHIPPO_API_KEY=
SHIPPO_WEBHOOK_SECRET=
