generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Vanom Ecommerce
 * ----------------
 * Channels: B2C + B2B
 * Countries: USA + Canada
 * Currencies: USD + CAD
 * Design:
 * - One shared Product/ProductVariant catalog.
 * - B2C/B2B availability and pricing are separate listings.
 * - One Order model for both B2C and B2B.
 * - B2B business accounts are verified before B2B purchasing.
 * - Inventory is variant + warehouse based.
 * - Financial values use Decimal and retain currency snapshots.
 * - Historical order data is snapshotted so catalog changes do not rewrite history.
 * Application business logic belongs in services.
 * There is intentionally no repository layer.
 */

enum Currency {
  USD
  CAD
}

enum UserStatus {
  ACTIVE
  PENDING
  INVITED
  SUSPENDED
  DELETED
}

enum CustomerType {
  B2C
  B2B
}

enum UserRole {
  CUSTOMER
  BUSINESS_USER
  ADMIN
  SUPER_ADMIN
}

enum BusinessStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  DELETED
}

enum BusinessMemberRole {
  OWNER
  ADMIN
  BUYER
  APPROVER
  VIEWER
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
  DELETED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  DELETED
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
}

enum PriceStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
}

enum PricingType {
  FIXED
  PERCENTAGE
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RESERVATION
  RELEASE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DAMAGE
  EXPIRED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderSource {
  WEB
  MOBILE
  ADMIN
  B2B_PORTAL
  API
  IMPORT
}

enum OrderChannel {
  B2C
  B2B
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum PaymentTransactionType {
  AUTHORIZE
  CAPTURE
  SALE
  VOID
  REFUND
  CHARGEBACK
}

enum ShipmentStatus {
  PENDING
  READY
  PICKED
  PACKED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum ShipmentType {
  STANDARD
  EXPRESS
  FREIGHT
  PALLET
  TRUCKLOAD
}

enum QuoteStatus {
  DRAFT
  REQUESTED
  UNDER_REVIEW
  QUOTED
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum AddressType {
  BILLING
  SHIPPING
  BUSINESS
  WAREHOUSE
}

enum TaxType {
  SALES_TAX
  ZERO_RATED
  EXEMPT
  OTHER
}

enum AdjustmentType {
  DISCOUNT
  PROMOTION
  COUPON
  SHIPPING
  TAX
  SURCHARGE
  MANUAL
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum FileType {
  BUSINESS_DOCUMENT
  PRODUCT_IMAGE
  PRODUCT_VIDEO
  CATEGORY_IMAGE
  USER_AVATAR
  INVOICE
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  PAYMENT
  REFUND
  STATUS_CHANGE
  EXPORT
  IMPORT
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum CheckoutStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum TaxCalculationStatus {
  PENDING
  CALCULATED
  FAILED
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum CouponStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CouponDiscountType {
  FIXED
  PERCENTAGE
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String
  firstName         String?
  lastName          String?
  phone             String?
  avatarUrl         String?
  status            UserStatus   @default(ACTIVE)
  customerType      CustomerType @default(B2C)
  preferredCurrency Currency     @default(USD)
  marketingOptIn    Boolean      @default(false)
  emailVerifiedAt   DateTime?
  mobileVerifiedAt  DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  roles                  UserRoleAssignment[]
  addresses              Address[]
  businessMemberships    BusinessMember[]
  orders                 Order[]
  carts                  Cart[]
  wishlists              Wishlist[]
  reviews                Review[]
  notifications          Notification[]
  auditLogs              AuditLog[]           @relation("AuditActor")
  couponRedemptions      CouponRedemption[]
  orderStatusHistories   OrderStatusHistory[] @relation("OrderStatusChangedBy")
  orderNotes             OrderNote[]          @relation("OrderNoteAuthor")
  idempotencyKeys        IdempotencyKey[]
  quotes                 Quote[]              @relation("QuoteRequester")
  approvedBusinesses     Business[]           @relation("BusinessApprover")
  purchaseOrders         PurchaseOrder[]      @relation("PurchaseOrderRequester")
  approvedPurchaseOrders PurchaseOrder[]      @relation("PurchaseOrderApprover")
  checkouts              Checkout[]

  @@index([status])
  @@index([customerType, status])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users UserRoleAssignment[]
}

model UserRoleAssignment {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model Business {
  id                 String         @id @default(uuid())
  legalName          String
  tradingName        String?
  registrationNumber String?
  taxId              String?
  countryId          String
  status             BusinessStatus @default(PENDING)
  approvedAt         DateTime?
  approvedById       String?
  paymentTermsDays   Int            @default(0)
  creditLimit        Decimal        @default(0) @db.Decimal(18, 2)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  country        Country             @relation(fields: [countryId], references: [id])
  approvedBy     User?               @relation("BusinessApprover", fields: [approvedById], references: [id])
  members        BusinessMember[]
  addresses      Address[]
  documents      BusinessDocument[]
  b2bListing     B2BProductListing[]
  carts          Cart[]
  orders         Order[]
  quotes         Quote[]
  purchaseOrders PurchaseOrder[]
  customerPrices B2BCustomerPrice[]

  @@index([countryId, status])
  @@index([status, createdAt])
  @@index([registrationNumber])
  @@index([taxId])
}

model BusinessMember {
  id         String             @id @default(uuid())
  businessId String
  userId     String
  role       BusinessMemberRole @default(BUYER)
  title      String?
  isPrimary  Boolean            @default(false)
  joinedAt   DateTime           @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId, role])
}

model BusinessDocument {
  id              String         @id @default(uuid())
  businessId      String
  fileAssetId     String
  documentType    String
  documentNumber  String?
  status          DocumentStatus @default(UPLOADED)
  issuedAt        DateTime?
  expiresAt       DateTime?
  rejectionReason String?
  uploadedAt      DateTime       @default(now())
  verifiedAt      DateTime?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  file     FileAsset @relation(fields: [fileAssetId], references: [id])

  @@index([businessId, status])
  @@index([expiresAt])
}

model Address {
  id         String      @id @default(uuid())
  userId     String?
  businessId String?
  type       AddressType
  name       String?
  company    String?
  line1      String
  line2      String?
  city       String
  stateCode  String
  postalCode String
  countryId  String
  phone      String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  country  Country   @relation(fields: [countryId], references: [id])

  @@index([userId, type])
  @@index([businessId, type])
  @@index([countryId, stateCode])
}

model Country {
  id       String   @id @default(uuid())
  code     String   @unique
  name     String
  currency Currency
  active   Boolean  @default(true)

  states         StateProvince[]
  businesses     Business[]
  addresses      Address[]
  carts          Cart[]
  orders         Order[]
  warehouses     Warehouse[]
  taxRules       TaxRule[]
  quotes         Quote[]
  purchaseOrders PurchaseOrder[]

  @@index([active])
}

model StateProvince {
  id        String  @id @default(uuid())
  countryId String
  code      String
  name      String
  active    Boolean @default(true)

  country  Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  taxRules TaxRule[]

  @@unique([countryId, code])
  @@index([countryId, active])
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  logoUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([active])
}

model Category {
  id           String   @id @default(uuid())
  parentId     String?
  name         String
  slug         String   @unique
  description  String?
  imageUrl     String?
  imageAssetId String?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent     Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]        @relation("CategoryTree")
  products   ProductCategory[]
  imageAsset FileAsset?        @relation("CategoryImage", fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@index([parentId, sortOrder])
  @@index([active])
}

model Product {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  brandId        String?
  description    String?
  status         ProductStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  isBestSeller   Boolean       @default(false)
  searchableText String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  brand              Brand?              @relation(fields: [brandId], references: [id])
  categories         ProductCategory[]
  images             ProductImage[]
  variants           ProductVariant[]
  attributes         ProductAttribute[]
  b2cListing         B2CProductListing?
  b2bListings        B2BProductListing[]
  wishlistItems      WishlistItem[]
  reviews            Review[]
  orderItems         OrderItem[]
  quoteItems         QuoteItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([brandId, status])
  @@index([status, createdAt])
  @@index([isFeatured, status])
}

model ProductCategory {
  id         String @id @default(uuid())
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String?
  variantId   String?
  fileAssetId String
  sortOrder   Int      @default(0)
  altText     String?
  createdAt   DateTime @default(now())

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  file    FileAsset       @relation(fields: [fileAssetId], references: [id])

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
}

model OptionType {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  values OptionValue[]
}

model OptionValue {
  id           String  @id @default(uuid())
  optionTypeId String
  value        String
  code         String
  sortOrder    Int     @default(0)
  active       Boolean @default(true)

  optionType    OptionType           @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  variantValues VariantOptionValue[]

  @@unique([optionTypeId, code])
  @@index([optionTypeId, sortOrder])
}

model ProductVariant {
  id        String        @id @default(uuid())
  productId String
  sku       String        @unique
  barcode   String?       @unique
  name      String?
  status    VariantStatus @default(ACTIVE)
  weight    Decimal?      @db.Decimal(12, 3)
  length    Decimal?      @db.Decimal(12, 3)
  width     Decimal?      @db.Decimal(12, 3)
  height    Decimal?      @db.Decimal(12, 3)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  images                ProductImage[]
  optionValues          VariantOptionValue[]
  attributes            ProductAttribute[]
  packaging             ProductPackaging[]
  b2cPrices             B2CPrice[]
  b2bPrices             B2BPrice[]
  inventoryItems        InventoryItem[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  quoteItems            QuoteItem[]
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]
  stockTransfers        StockTransfer[]
  customerPrices        B2BCustomerPrice[]
  purchaseOrderItems    PurchaseOrderItem[]

  @@index([productId, status])
}

model VariantOptionValue {
  id        String @id @default(uuid())
  variantId String
  valueId   String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value   OptionValue    @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([variantId, valueId])
  @@index([valueId])
}

model Attribute {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  dataType  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  values   AttributeValue[]
  products ProductAttribute[]
}

model AttributeValue {
  id          String @id @default(uuid())
  attributeId String
  value       String
  code        String

  attribute Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products  ProductAttribute[]

  @@unique([attributeId, code])
}

model ProductAttribute {
  id          String  @id @default(uuid())
  productId   String
  variantId   String?
  attributeId String
  valueId     String?
  customValue String?

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute Attribute       @relation(fields: [attributeId], references: [id])
  value     AttributeValue? @relation(fields: [valueId], references: [id])

  @@index([productId, attributeId])
  @@index([variantId, attributeId])
}

model ProductPackaging {
  id                String   @id @default(uuid())
  variantId         String
  packagingType     String
  unitsPerPackage   Int?
  packagesPerPallet Int?
  palletCapacity    Int?
  weightPerPackage  Decimal? @db.Decimal(12, 3)
  leadTimeDays      Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

model B2CProductListing {
  id        String        @id @default(uuid())
  productId String        @unique
  status    ListingStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices  B2CPrice[]
}

model B2CPrice {
  id        String      @id @default(uuid())
  listingId String
  variantId String
  currency  Currency
  status    PriceStatus @default(ACTIVE)
  price     Decimal     @db.Decimal(18, 4)
  compareAt Decimal?    @db.Decimal(18, 4)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  listing B2CProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variant ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([listingId, variantId, currency, startsAt])
  @@index([variantId, currency, status])
}

model B2BProductListing {
  id           String        @id @default(uuid())
  productId    String
  businessId   String?
  status       ListingStatus @default(ACTIVE)
  moq          Int           @default(1)
  leadTimeDays Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  business Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  prices   B2BPrice[]
  tiers    B2BPriceTier[]

  @@unique([productId, businessId])
  @@index([businessId, status])
  @@index([productId, status])
}

model B2BPrice {
  id        String      @id @default(uuid())
  listingId String
  variantId String
  currency  Currency
  status    PriceStatus @default(ACTIVE)
  unitPrice Decimal     @db.Decimal(18, 4)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  listing B2BProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variant ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([listingId, variantId, currency, startsAt])
  @@index([variantId, currency, status])
}

model B2BPriceTier {
  id            String      @id @default(uuid())
  listingId     String
  tierNumber    Int
  name          String?
  minQuantity   Int
  maxQuantity   Int?
  discountType  PricingType @default(PERCENTAGE)
  discountValue Decimal     @default(0) @db.Decimal(8, 4)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  listing B2BProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, tierNumber])
  @@index([listingId, minQuantity])
}

model B2BCustomerPrice {
  id         String    @id @default(uuid())
  businessId String
  variantId  String
  currency   Currency
  unitPrice  Decimal   @db.Decimal(18, 4)
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([businessId, variantId, currency])
  @@index([variantId, currency, active])
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  countryId String
  addressId String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country      Country                @relation(fields: [countryId], references: [id])
  inventory    InventoryItem[]
  reservations InventoryReservation[]
  movements    InventoryMovement[]
  transfersOut StockTransfer[]        @relation("TransferFromWarehouse")
  transfersIn  StockTransfer[]        @relation("TransferToWarehouse")

  @@index([countryId, active])
}

model InventoryItem {
  id              String   @id @default(uuid())
  warehouseId     String
  variantId       String
  onHand          Int      @default(0)
  reserved        Int      @default(0)
  available       Int      @default(0)
  reorderPoint    Int      @default(0)
  reorderQuantity Int      @default(0)
  updatedAt       DateTime @updatedAt

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, variantId])
  @@index([variantId])
}

model InventoryReservation {
  id          String            @id @default(uuid())
  orderId     String?
  cartId      String?
  warehouseId String
  variantId   String
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  order     Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cart      Cart?          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId, status])
  @@index([cartId, status])
  @@index([warehouseId, variantId, status])
  @@index([expiresAt, status])
}

model InventoryMovement {
  id          String                @id @default(uuid())
  warehouseId String
  variantId   String
  type        InventoryMovementType
  quantity    Int
  referenceId String?
  reason      String?
  metadata    Json?
  createdAt   DateTime              @default(now())

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([warehouseId, variantId, createdAt])
  @@index([referenceId])
}

model StockTransfer {
  id              String              @id @default(uuid())
  fromWarehouseId String
  toWarehouseId   String
  variantId       String
  quantity        Int
  status          StockTransferStatus @default(PENDING)
  referenceNumber String?
  notes           String?
  shippedAt       DateTime?
  receivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  fromWarehouse Warehouse      @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse      @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@index([fromWarehouseId, status])
  @@index([toWarehouseId, status])
  @@index([variantId, status])
}

model Cart {
  id         String     @id @default(uuid())
  userId     String
  businessId String?
  countryId  String
  currency   Currency
  status     CartStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business?              @relation(fields: [businessId], references: [id], onDelete: SetNull)
  country      Country                @relation(fields: [countryId], references: [id])
  items        CartItem[]
  checkouts    Checkout[]
  reservations InventoryReservation[]

  @@index([userId, status])
  @@index([businessId, status])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int
  unitPrice Decimal? @db.Decimal(18, 4)
  currency  Currency
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Checkout {
  id             String         @id @default(uuid())
  cartId         String
  userId         String
  status         CheckoutStatus @default(PENDING)
  currency       Currency
  subtotal       Decimal        @db.Decimal(18, 2)
  discountAmount Decimal        @default(0) @db.Decimal(18, 2)
  shippingAmount Decimal        @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal        @db.Decimal(18, 2)
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  cart  Cart   @relation(fields: [cartId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
  order Order?

  @@index([userId, status])
  @@index([cartId, status])
}

model Order {
  id               String       @id @default(uuid())
  orderNumber      String       @unique
  userId           String
  businessId       String?
  customerType     CustomerType
  channel          OrderChannel
  source           OrderSource
  status           OrderStatus  @default(DRAFT)
  countryId        String
  currency         Currency
  subtotal         Decimal      @db.Decimal(18, 2)
  discountAmount   Decimal      @default(0) @db.Decimal(18, 2)
  shippingAmount   Decimal      @default(0) @db.Decimal(18, 2)
  taxAmount        Decimal      @default(0) @db.Decimal(18, 2)
  totalAmount      Decimal      @db.Decimal(18, 2)
  billingAddress   Json
  shippingAddress  Json
  customerSnapshot Json
  notes            String?
  placedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  checkoutId       String?      @unique

  user              User                   @relation(fields: [userId], references: [id])
  business          Business?              @relation(fields: [businessId], references: [id])
  country           Country                @relation(fields: [countryId], references: [id])
  checkout          Checkout?              @relation(fields: [checkoutId], references: [id])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  adjustments       OrderAdjustment[]
  addresses         OrderAddress[]
  payments          Payment[]
  shipments         Shipment[]
  reservations      InventoryReservation[]
  couponRedemptions CouponRedemption[]
  taxCalculation    TaxCalculation?
  notesLog          OrderNote[]
  purchaseOrders    PurchaseOrder[]

  @@index([userId, createdAt])
  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@index([countryId, currency])
  @@index([channel, status, createdAt])
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  productId           String?
  variantId           String?
  skuSnapshot         String
  productNameSnapshot String
  variantNameSnapshot String?
  quantity            Int
  unitPrice           Decimal  @db.Decimal(18, 4)
  subtotal            Decimal  @db.Decimal(18, 2)
  discountAmount      Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount           Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount         Decimal  @db.Decimal(18, 2)
  currency            Currency
  taxRateSnapshot     Decimal  @default(0) @db.Decimal(8, 4)
  packagingSnapshot   Json?

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  shipmentItems ShipmentItem[]
  taxLines      TaxLine[]

  @@index([orderId])
  @@index([variantId])
}

model OrderAddress {
  id        String      @id @default(uuid())
  orderId   String
  type      AddressType
  snapshot  Json
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type])
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  reason      String?
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("OrderStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model OrderAdjustment {
  id          String         @id @default(uuid())
  orderId     String
  type        AdjustmentType
  description String?
  amount      Decimal        @db.Decimal(18, 2)
  metadata    Json?
  createdAt   DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type])
}

model OrderNote {
  id        String   @id @default(uuid())
  orderId   String
  userId    String?
  note      String
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation("OrderNoteAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  currency          Currency
  provider          String
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(18, 2)
  capturedAmount    Decimal       @default(0) @db.Decimal(18, 2)
  refundedAmount    Decimal       @default(0) @db.Decimal(18, 2)
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order        Order                @relation(fields: [orderId], references: [id])
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([orderId, status])
  @@index([provider, providerPaymentId])
}

model PaymentTransaction {
  id                String                 @id @default(uuid())
  paymentId         String
  type              PaymentTransactionType
  providerReference String?
  amount            Decimal                @db.Decimal(18, 2)
  status            PaymentStatus
  response          Json?
  createdAt         DateTime               @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

model Refund {
  id               String        @id @default(uuid())
  paymentId        String
  amount           Decimal       @db.Decimal(18, 2)
  reason           String?
  providerRefundId String?
  status           PaymentStatus @default(PENDING)
  createdAt        DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId, createdAt])
}

model PaymentWebhook {
  id              String        @id @default(uuid())
  provider        String
  externalEventId String        @unique
  status          WebhookStatus @default(RECEIVED)
  payload         Json
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?
  errorMessage    String?

  @@index([provider, status])
}

model Shipment {
  id              String         @id @default(uuid())
  orderId         String
  warehouseId     String?
  type            ShipmentType   @default(STANDARD)
  status          ShipmentStatus @default(PENDING)
  carrier         String?
  service         String?
  trackingNumber  String?
  trackingUrl     String?
  shippingAddress Json
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ShipmentItem[]

  @@index([orderId, status])
  @@index([trackingNumber])
}

model ShipmentItem {
  id          String @id @default(uuid())
  shipmentId  String
  orderItemId String
  quantity    Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([shipmentId, orderItemId])
}

model TaxRule {
  id        String    @id @default(uuid())
  countryId String
  stateId   String?
  name      String
  type      TaxType
  rate      Decimal   @db.Decimal(8, 4)
  priority  Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  country Country        @relation(fields: [countryId], references: [id], onDelete: Cascade)
  state   StateProvince? @relation(fields: [stateId], references: [id], onDelete: Cascade)
  lines   TaxLine[]

  @@index([countryId, stateId, active])
}

model TaxCalculation {
  id           String               @id @default(uuid())
  orderId      String               @unique
  status       TaxCalculationStatus @default(PENDING)
  subtotal     Decimal              @db.Decimal(18, 2)
  taxAmount    Decimal              @db.Decimal(18, 2)
  response     Json?
  calculatedAt DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model TaxLine {
  id            String  @id @default(uuid())
  orderItemId   String
  taxRuleId     String?
  name          String
  type          TaxType
  rate          Decimal @db.Decimal(8, 4)
  taxableAmount Decimal @db.Decimal(18, 2)
  taxAmount     Decimal @db.Decimal(18, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  taxRule   TaxRule?  @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
}

model Quote {
  id             String      @id @default(uuid())
  quoteNumber    String      @unique
  businessId     String
  requestedById  String
  countryId      String
  currency       Currency
  status         QuoteStatus @default(DRAFT)
  subtotal       Decimal     @default(0) @db.Decimal(18, 2)
  discountAmount Decimal     @default(0) @db.Decimal(18, 2)
  shippingAmount Decimal     @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal     @default(0) @db.Decimal(18, 2)
  validUntil     DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  business       Business        @relation(fields: [businessId], references: [id])
  requestedBy    User            @relation("QuoteRequester", fields: [requestedById], references: [id])
  country        Country         @relation(fields: [countryId], references: [id])
  items          QuoteItem[]
  purchaseOrders PurchaseOrder[]

  @@index([businessId, status, createdAt])
}

model QuoteItem {
  id                    String    @id @default(uuid())
  quoteId               String
  productId             String?
  variantId             String?
  skuSnapshot           String
  productNameSnapshot   String
  quantity              Int
  unitPrice             Decimal   @db.Decimal(18, 4)
  subtotal              Decimal   @db.Decimal(18, 2)
  packagingSnapshot     Json?
  requestedDeliveryDate DateTime?

  quote   Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([variantId])
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  poNumber       String              @unique
  businessId     String
  requestedById  String
  approvedById   String?
  quoteId        String?
  orderId        String?
  countryId      String
  currency       Currency
  status         PurchaseOrderStatus @default(DRAFT)
  totalAmount    Decimal             @default(0) @db.Decimal(18, 2)
  documentNumber String?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  business    Business            @relation(fields: [businessId], references: [id])
  requestedBy User                @relation("PurchaseOrderRequester", fields: [requestedById], references: [id])
  approvedBy  User?               @relation("PurchaseOrderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  quote       Quote?              @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  country     Country             @relation(fields: [countryId], references: [id])
  items       PurchaseOrderItem[]

  @@index([businessId, status, createdAt])
  @@index([orderId])
  @@index([quoteId])
}

model PurchaseOrderItem {
  id                  String  @id @default(uuid())
  purchaseOrderId     String
  productId           String?
  variantId           String?
  skuSnapshot         String
  productNameSnapshot String
  quantity            Int
  unitPrice           Decimal @db.Decimal(18, 4)
  totalAmount         Decimal @db.Decimal(18, 2)

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([variantId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  name      String   @default("Default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@unique([userId, name])
  @@index([userId])
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([wishlistId, productId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  title     String?
  body      String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  product Product       @relation(fields: [productId], references: [id])
  media   ReviewMedia[]

  @@index([productId, approved, createdAt])
  @@index([userId, createdAt])
}

model ReviewMedia {
  id          String @id @default(uuid())
  reviewId    String
  fileAssetId String

  review Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  file   FileAsset @relation(fields: [fileAssetId], references: [id])

  @@unique([reviewId, fileAssetId])
}

model Coupon {
  id            String             @id @default(uuid())
  code          String             @unique
  description   String?
  status        CouponStatus       @default(DRAFT)
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(18, 4)
  minOrderValue Decimal?           @db.Decimal(18, 2)
  maxDiscount   Decimal?           @db.Decimal(18, 2)
  usageLimit    Int?
  usageCount    Int                @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  redemptions CouponRedemption[]

  @@index([status, startsAt, endsAt])
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  orderId   String
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([couponId, orderId])
  @@index([userId, createdAt])
}

model Notification {
  id          String              @id @default(uuid())
  userId      String
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  subject     String?
  message     String
  templateKey String?
  metadata    Json?
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model FileAsset {
  id         String   @id @default(uuid())
  type       FileType
  fileName   String
  storageKey String   @unique
  url        String?
  mimeType   String
  sizeBytes  BigInt
  createdAt  DateTime @default(now())

  businessDocuments BusinessDocument[]
  productImages     ProductImage[]
  categoryImages    Category[]         @relation("CategoryImage")
  reviewMedia       ReviewMedia[]
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
}

model IdempotencyKey {
  id             String            @id @default(uuid())
  key            String
  userId         String
  requestHash    String
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
}
